{
  "expo": {
    "name": "Моя Полка",
    "slug": "ownshelf",
    "owner": "headtop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ownshelf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ownshelf.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ownshelf.app",
      "adaptiveIcon": {
        "backgroundColor": "#EC3013",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к галерее, чтобы выбрать обложку книги.",
          "cameraPermission": "Приложению нужен доступ к камере, чтобы сфотографировать обложку книги."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0751a34c-7369-4f77-ae5a-1854eda8e0a9"
      }
    }
  }
}
